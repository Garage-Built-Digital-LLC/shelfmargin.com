# Copy to .env.local and fill in. Vite exposes VITE_* vars to the client.
# The publishable/anon key is safe to ship in a client app (RLS protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Enables live title/author catalog lookup from public book APIs.
# Amazon prices/ranks remain estimates until Amazon SP-API is wired server-side.
VITE_USE_LIVE=false

# Stripe test mode.
# VITE_STRIPE_PUBLISHABLE_KEY is browser-safe. Do not put secret keys under VITE_.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Server-only. These are read by local Docker/server code, never browser code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxx

# Amazon SP-API. Server-only. Do not prefix these with VITE_.
# Use sandbox credentials first; switch mode only after production app access works.
AMAZON_SP_API_MODE=sandbox
AMAZON_SP_API_ENDPOINT=https://sandbox.sellingpartnerapi-na.amazon.com
AMAZON_SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SP_API_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_SP_API_LWA_CLIENT_SECRET=xxxxxxxx
AMAZON_SP_API_REFRESH_TOKEN=Atzr|xxxxxxxx

# Optional sandbox-specific aliases. These are used only when
# AMAZON_SP_API_MODE=sandbox. Leave production variables empty if you are testing
# sandbox credentials only.
AMAZON_SP_API_SANDBOX_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
AMAZON_SP_API_SANDBOX_LWA_CLIENT_SECRET=xxxxxxxx
AMAZON_SP_API_SANDBOX_REFRESH_TOKEN=Atzr|xxxxxxxx

# Public app URL used by server-created Stripe Checkout redirects.
APP_BASE_URL=http://localhost:5173

# Optional server-side error monitoring. If set, unexpected 500s are POSTed here
# as JSON (works with Slack/Discord incoming webhooks or any collector). Leave
# empty to rely on structured stdout logs only (captured by your host).
ERROR_WEBHOOK_URL=
