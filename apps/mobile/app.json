{
  "expo": {
    "name": "Shelf Margin",
    "slug": "shelf-margin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shelfmargin",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shelfmargin.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Shelf Margin uses the camera to scan book barcodes (ISBNs)."
      }
    },
    "android": {
      "package": "com.shelfmargin.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Shelf Margin uses the camera to scan book barcodes (ISBNs)."
        }
      ]
    ]
  }
}